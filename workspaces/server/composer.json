{
    "name": "shuta13/ts-php-type-bridge-server",
    "description": "PHP server for ts-php-type-bridge demo.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Shuta13\\Server\\": "src/"
        }
    },
    "authors": [
        {
            "name": "shuta13"
        }
    ],
    "minimum-stability": "stable",
    "scripts": {
        "format": "./vendor/bin/php-cs-fixer fix",
        "phpstan": "./vendor/bin/phpstan analyze -c phpstan.neon",
        "bridge": "php scripts/types_bridge.php",
        "bridge:showcase": "php scripts/showcase_bridge.php"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "nikic/php-parser": "^5.4"
    }
}
